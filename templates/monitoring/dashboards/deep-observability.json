{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Deep Cluster & Pod Observability",
  "tags": ["moreops", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Top Pods by CPU Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "topk(5, sum(rate(container_cpu_usage_seconds_total[5m])) by (pod, node))",
          "legendFormat": "{{pod}} ({{node}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inter-Pod Request Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    }
  ]
}
